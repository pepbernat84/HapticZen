    "onboarding.swipe.desc": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "També pots lliscar cap a l'esquerra des de la vora dreta de la pantalla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also swipe left from the right edge of the screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes deslizar hacia la izquierda desde el borde derecho de la pantalla."
          }
        }
      }
    },
