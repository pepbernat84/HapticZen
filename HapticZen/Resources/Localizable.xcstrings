{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "accessibility.canvas.hint": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca i arrossega per sentir les textures. Fes doble toc amb dos dits per obrir el menú principal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and drag to feel textures. Double tap with two fingers to open the main menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca y arrastra para sentir las texturas. Toca dos veces con dos dedos para abrir el menú principal."
          }
        }
      }
    },
    "accessibility.canvas.label": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llenç hàptic"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Haptic Canvas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lienzo háptico"
          }
        }
      }
    },
    "accessibility.menu.close": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tancar menú"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close menu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar menú"
          }
        }
      }
    },
    "breathing.footer": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca suau el cercle luminescent i mantén el dit mentre respires amb el ritme hàptic."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently touch the luminescent circle and hold to feel the haptic breathing rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca suavemente el círculo luminiscente y mantén el dedo para sentir el ritmo háptico."
          }
        }
      }
    },
    "breathing.instruction": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per sentir el ritme de la respiració"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch to feel the breathing rhythm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para sentir el ritmo de la respiración"
          }
        }
      }
    },
