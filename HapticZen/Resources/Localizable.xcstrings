    "onboarding.drag.desc": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llisca i mou el dit pel llenç per sentir texturades i sons ASMR en temps real."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag across the canvas to feel dynamic tactile textures and ASMR audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza el dedo por el lienzo para sentir texturas y sonidos ASMR en tiempo real."
          }
        }
      }
    },
    "onboarding.drag.title": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per Sentir"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch to Feel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para Sentir"
          }
        }
      }
    },
    "onboarding.menu.desc": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca amb 3 dits simultàniament a qualsevol punt per obrir el menú secret."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap anywhere with 3 fingers simultaneously to open the secret menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca con 3 dedos simultáneamente en cualquier punto para abrir el menú secreto."
          }
        }
      }
    },
    "onboarding.menu.title": {
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
